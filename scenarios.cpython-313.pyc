from sqlalchemy import select, func, desc
from app.models import Event, Alert, Asset

def build_dashboard(db, scenario_id: str) -> dict:
    total_events = db.scalar(select(func.count()).select_from(Event).where(Event.scenario_id == scenario_id)) or 0
    total_alerts = db.scalar(select(func.count()).select_from(Alert).where(Alert.scenario_id == scenario_id)) or 0
    total_assets = db.scalar(select(func.count()).select_from(Asset).where(Asset.scenario_id == scenario_id)) or 0
    parsed = db.scalar(select(func.count()).select_from(Event).where(Event.scenario_id == scenario_id, Event.parse_status == "parsed")) or 0
    partial = db.scalar(select(func.count()).select_from(Event).where(Event.scenario_id == scenario_id, Event.parse_status == "partial")) or 0
    failed = db.scalar(select(func.count()).select_from(Event).where(Event.scenario_id == scenario_id, Event.parse_status == "failed")) or 0

    by_source = db.execute(select(Event.source, func.count()).where(Event.scenario_id == scenario_id).group_by(Event.source).order_by(desc(func.count()))).all()
    by_severity = db.execute(select(Alert.severity, func.count()).where(Alert.scenario_id == scenario_id).group_by(Alert.severity).order_by(desc(func.count()))).all()
    top_hosts = db.execute(select(Event.hostname, func.count()).where(Event.scenario_id == scenario_id, Event.hostname.is_not(None)).group_by(Event.hostname).order_by(desc(func.count())).limit(10)).all()
    top_users = db.execute(select(Event.username, func.count()).where(Event.scenario_id == scenario_id, Event.username.is_not(None)).group_by(Event.username).order_by(desc(func.count())).limit(10)).all()
    timeline = db.execute(select(Event.timestamp, func.count()).where(Event.scenario_id == scenario_id, Event.timestamp.is_not(None)).group_by(Event.timestamp).order_by(Event.timestamp).limit(100)).all()
    latest_alerts = db.execute(select(Alert).where(Alert.scenario_id == scenario_id).order_by(desc(Alert.id)).limit(10)).scalars().all()

    return {
        "summary": {
            "total_events": total_events,
            "total_alerts": total_alerts,
            "total_assets": total_assets,
            "parse_success_rate": round((parsed / total_events) * 100, 2) if total_events else 0,
            "parsed": parsed,
            "partial": partial,
            "failed": failed,
        },
        "by_source": [{"label": a or "unknown", "value": b} for a, b in by_source],
        "by_severity": [{"label": a or "unknown", "value": b} for a, b in by_severity],
        "top_hosts": [{"label": a or "unknown", "value": b} for a, b in top_hosts],
        "top_users": [{"label": a or "unknown", "value": b} for a, b in top_users],
        "timeline": [{"label": a, "value": b} for a, b in timeline],
        "latest_alerts": latest_alerts,
    }
